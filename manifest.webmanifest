{
  "name": "Notes",
  "short_name": "Notes",
  "description": "Six colourful boxes for tasks, thoughts, plans and reminders.",
  "start_url": "./notes.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFFFFF",
